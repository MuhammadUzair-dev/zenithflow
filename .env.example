# ============================================
# ZenithFlow – Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
#
# Current Status: ZenithFlow runs fully client-side.
# These variables are reserved for future API integrations.
# ============================================

# ---- AI Agent API Keys (Future) ----
# Used by the Architect Agent for LLM-powered interviews
# VITE_GROQ_API_KEY=your_groq_api_key_here
# VITE_OPENAI_API_KEY=your_openai_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ---- Resource Scavenger APIs (Future) ----
# Used by the Scavenger Agent to fetch live resources
# VITE_YOUTUBE_API_KEY=your_youtube_data_api_key_here
# VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# ---- Analytics (Optional) ----
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ---- Deployment ----
# VITE_BASE_URL=https://zenithflow.vercel.app
